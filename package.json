    "better-auth": "latest",
    "dotenv": "^17.4.2",
    "pg": "^8.20.0",
    "ts-node": "^10.9.2",
    "turbo": "latest",
    "typescript": "latest"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@9.0.6",
  "dependencies": {
    "@prisma/client": "^7.8.0"
  },
  "pnpm": {
    "overrides": {
      "@tiptap/*": "2.1.13",
      "better-auth": "1.6.11",
